[Unit]
Description=PlcBridge Web Admin (SQLite + REST API)
Documentation=https://github.com/plcbridge/plcbridge
After=network.target

[Service]
Type=simple
User=plcbridge
Group=plcbridge
WorkingDirectory=/opt/plcbridge
ExecStart=/opt/plcbridge/bin/plcbridge-web --config /etc/plcbridge --addr :8080
Restart=always
RestartSec=5

# === API 密钥 ===
#
# 必须与 plcbridge.service 用同一个密钥。
# 两个 unit 的 --config 都是 /etc/plcbridge → 共享 /etc/plcbridge/api.secret。
# 首次启动时 whoever 先起来谁生成（O_EXCL 独占创建，原子安全）。
#
# ⚠️ 不要把密钥写进本 unit 文件 —— unit 文件全局可读。
#    如需用环境变量注入，请用 EnvironmentFile（权限 0600）：
#      echo "PLCBRIDGE_API_SECRET=<随机串>" > /etc/plcbridge/api.env
#      chmod 600 /etc/plcbridge/api.env
EnvironmentFile=-/etc/plcbridge/api.env

KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=10

LimitNOFILE=65536

StandardOutput=journal
StandardError=journal
SyslogIdentifier=plcbridge-web

[Install]
WantedBy=multi-user.target
